+def _r66_phrase_match(text, phrase):
+    """Boundary-safe token/phrase matcher for positive F01 evidence.
+
+    Internal substrings never match.  A single Korean lexical atom must be an
+    exact token or carry only a small whitelisted grammatical suffix.  For
+    multi-token phrases, prefix alignment is allowed inside each already
+    separated token so ordinary inflectional fragments such as ``사실이 드러``
+    can match ``사실이 드러난다`` without permitting ``시한`` inside
+    ``표시한다``.
+    """
+    text_tokens=_r64_tokens(text)
+    phrase_tokens=_r64_tokens(phrase)
+    if not phrase_tokens or not text_tokens or len(phrase_tokens)>len(text_tokens):
+        return False
+
+    ko_suffixes=(
+        "이","가","을","를","은","는","에","에서","에게","한테",
+        "와","과","도","만","까지","부터","의","로","으로",
+        "이다","입니다","이었다","였다","이고","이며","이면","이라","이라고",
+        "하다","한다","했다","하는","한","해","해서","하고","하며","하면",
+        "되다","된다","됐다","되는","된","돼","되어"
+    )
+
+    def atom_match(tok,ptok,multi):
+        if tok==ptok:
+            return True
+        if re.fullmatch(r"[A-Za-z0-9]+", ptok):
+            return tok.lower()==ptok.lower()
+        if re.fullmatch(r"[가-힣]+", ptok):
+            if multi:
+                # Token boundary already proves we are not inside another word.
+                return tok.startswith(ptok)
+            return any(tok==ptok+s for s in ko_suffixes)
+        return False
+
+    n=len(phrase_tokens)
+    multi=n>1
+    for i in range(len(text_tokens)-n+1):
+        if all(atom_match(tok,ptok,multi) for tok,ptok in zip(text_tokens[i:i+n],phrase_tokens)):
+            return True
+    return False
+
