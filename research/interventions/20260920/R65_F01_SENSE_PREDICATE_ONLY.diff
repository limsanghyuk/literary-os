+def _r65_transaction_decision(o):
+    baseline=_r58_stage_plan_for_obligation(o)
+    if baseline==["RESOLVE"]:
+        return {"mode":"BASELINE_ONLY","proposal":None,"selected":"RESOLVE",
+                "baseline":"RESOLVE","reason":"R58_SIMPLE_DEPTH_BOUNDARY",
+                "required_predicate":None,"evidence":[]}
+    proposal=_select_transaction_precursor(o)
+    rec=_r65_semantic_license(o,proposal)
+    if rec["licensed"]:
+        return {"mode":"ACCEPT","proposal":proposal,"selected":proposal,
+                "baseline":baseline[0],"reason":rec["reason"],
+                "required_predicate":rec["required_predicate"],"evidence":rec["evidence"]}
+    return {"mode":"ABSTAIN","proposal":proposal,"selected":baseline[0],
+            "baseline":baseline[0],"reason":rec["reason"],
+            "required_predicate":rec["required_predicate"],"evidence":rec["evidence"]}
